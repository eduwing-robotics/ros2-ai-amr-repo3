# Main server public URL reachable from Movement/Camera/Vision callbacks.
LMS_PUBLIC_BASE_URL=http://smartfactory-main.local:8088
# Nav callbacks are server-owned and stay on the canonical site hostname.
LMS_CALLBACK_BASE_URL=http://smartfactory-main.local:8088
LMS_CALLBACK_ALLOWLIST=http://smartfactory-main.local:8088
LMS_CALLBACK_ALLOW_HTTP=true
# Hardware-less tests may use loopback only when both flags and the exact origin are set.
LMS_NOHARDWARE=false
LMS_NOHARDWARE_CALLBACK_ALLOWLIST=

# PostgreSQL runtime DB. Required for real backend work.  Compose requires
# PostgreSQL URL is derived from this secret unless LMS_DATABASE_URL is explicitly supplied.
# Do not commit a password. Runtime startup fails closed when neither is set.
LMS_POSTGRES_PASSWORD=
# LMS_DATABASE_URL=postgresql://lms:<url-encoded-password>@localhost:5433/lms_mvp
LMS_MAP_ASSETS_DIR=./maps

# Legacy SQLite path variables are intentionally omitted from the default template.
# Do not use SQLite for new development or operations.

# Movement/Nav2 server routing.
# fake: Movement 서버 없이 화면/API 확인
# http: 실제 Movement 서버 호출
LMS_MOVEMENT_CLIENT_MODE=http
LMS_MOVEMENT_HOST=smartfactory-nav.local
# LMS_MOVEMENT_BASE_URLS=tb3_1=http://smartfactory-nav.local:8001/movement-api/v1,tb3_2=http://smartfactory-nav.local:8002/movement-api/v1
LMS_MOVEMENT_ACTIVE_MAP_ID=robot2_map
LMS_MOVEMENT_TIMEOUT_SEC=3.0
LMS_MOVEMENT_HEALTH_TIMEOUT_SEC=0.8
# Main↔Nav HMAC is loaded by scripts/real.sh from the ignored repository-level
# .secrets/service-hmac.env bundle. Do not duplicate it in this file.
LMS_MOVEMENT_HMAC_CLOCK_SKEW_SEC=60

# Camera server (rosbridge). UI 카메라 배지는 Vision stream(:8090) health.
LMS_CAMERA_HOST=smartfactory-nav.local
LMS_CAMERA_API_PORT=8080
LMS_CAMERA_STREAM_PORT=9090
# LMS_CAMERA_STREAM_URL_TEMPLATE=ws://{host}:9090/{source_id}

# Vision/AI server and MJPEG stream bridge.
# Canonical hostname only. Do not add an IP fallback.
LMS_VISION_API_BASE_URL=http://smartfactory-vision.local:8100
LMS_VISION_STREAM_BASE_URL=http://smartfactory-vision.local:8090
LMS_VISION_TIMEOUT_SEC=2.0
LMS_VISION_STREAM_TIMEOUT_SEC=3.0

# Lift/load evidence gate. Fail-safe default is disabled; if enabled with mode=gate,
# Main holds orchestration unless Vision returns PASS and command_satisfying=true.
# mode=record preserves legacy record-only behavior and never approves movement from AI alone.
LMS_LIFT_LOAD_EVIDENCE_ENABLED=false
LMS_LIFT_LOAD_EVIDENCE_MODE=record
LMS_LIFT_LOAD_EVIDENCE_SOURCE=global_cam_01
# Item -> ArUco mapping is managed in Main PostgreSQL and the warehouse admin UI.
# Explicitly enable only during TB1 nonphysical commissioning. Requests must
# also set admit_nonphysical=true; physical inventory is never mutated.
LMS_NONPHYSICAL_TASK_ADMISSION_ENABLED=false
LMS_LIFT_LOAD_BURST_FRAMES=5
LMS_LIFT_LOAD_MIN_PASS_FRAMES=1
LMS_LIFT_LOAD_SAMPLE_INTERVAL_MS=80
LMS_LIFT_LOAD_MAX_FRAME_AGE_S=2.0
# Main-side freshness gate for the AI monitor event's observed_at. This is
# separate from MAX_FRAME_AGE_S, which is the frame-age policy sent to AI.
LMS_LIFT_LOAD_EVIDENCE_MAX_AGE_S=5.0
LMS_LIFT_LOAD_EVIDENCE_CLOCK_SKEW_S=1.0

# Person hazard (PHASE_77) — AI advisory polling; set ENABLED=false to disable auto E-stop.
LMS_PERSON_HAZARD_ENABLED=true
LMS_PERSON_HAZARD_TARGET_FPS=3
LMS_PERSON_HAZARD_POLL_HZ=3
LMS_PERSON_HAZARD_STALE_SEC=2.0
LMS_PERSON_HAZARD_COOLDOWN_SEC=2.0
LMS_PERSON_HAZARD_TIMEOUT_SEC=0.5

# Recovery (PHASE_78) — dock_transfer auto-unload only when Movement /robot-commands verified.
LMS_RECOVERY_SAFE_LOCATION_ID=HOME_01

# Frontend build — WebRTC transport primary (PHASE_38). Vision sidecar ready + UDP media 검증 후 활성화.
# sidecar not_configured면 프론트가 자동 MJPEG 폴백한다.
VITE_VISION_WEBRTC_ENABLED=true
# 개발·시그널링 테스트: MJPEG 폴백 끔. ONLY=true면 ENABLED 없이도 WebRTC 경로만 시도한다.
# VITE_VISION_WEBRTC_ONLY=true

# Manual control defaults.
LMS_MANUAL_ROTATE_DURATION_SEC=1.0
LMS_MANUAL_ROTATE_ANGULAR_Z=0.5
LMS_MANUAL_TRANSLATE_DURATION_SEC=1.0
LMS_MANUAL_TRANSLATE_LINEAR_X=0.1
LMS_MANUAL_HOLD_TIMEOUT_SEC=2.0

# Frontend dev server proxy target.
VITE_API_PROXY_TARGET=http://smartfactory-main.local:8088

# Main↔AI HMAC is loaded by scripts/real.sh from the same ignored credential
# bundle. Missing/invalid bundles fail before production startup.
LMS_VISION_HMAC_CLOCK_SKEW_SEC=60
