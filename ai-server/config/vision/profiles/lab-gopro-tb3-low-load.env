# Low-load public WebRTC burned-overlay profile.
# Use when GoPro full + tb3_1/tb3_2 PiCam are needed on a weaker Vision PC/laptop.
# Differences from lab-gopro-tb3-ffmpeg-first:
#   - global_cam_01/lift_roi WebRTC publisher is disabled to save crop/encode work.
#   - MJPEG fallback and evidence API helpers remain available.
# Robot-side camera launch is still manual/safety-owned:
#   ROS_DOMAIN_ID=2 ros2 launch turtlebot3_bringup camera_low_bandwidth.launch.py
# Full profile when lift_roi WebRTC is needed:
#   ./scripts/vision/sf_vision.sh up lab-gopro-tb3-ffmpeg-first
SF_VISION_DESCRIPTION="low-load lab demo: burned-overlay WebRTC for GoPro global_cam_01/full + tb3_1/tb3_2 PiCam, lift_roi WebRTC off"
SF_VISION_GOPRO_ENABLED=true
SF_VISION_WEBRTC_SIDECAR_ENABLED=true
SF_VISION_GOPRO_ADAPTER_AFTER_WEBRTC_SIDECAR=true
SF_VISION_GOPRO_MEDIAMTX_READY_PATH=
SF_VISION_GOPRO_MEDIAMTX_READY_TIMEOUT_SEC=90

AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8100
VISION_PUBLIC_HOST=smartfactory-vision.local
MAIN_SERVER_URL=http://smartfactory-main.local:8088
AI_SERVER_CORS_ALLOW_ORIGINS=http://smartfactory-main.local:8088,http://localhost:8088,http://127.0.0.1:8088

VISION_MODEL_WORKER_ENABLED=true
VISION_MODEL_PATH=models/yolov8n.pt
VISION_MODEL_TASK=detect
VISION_MODEL_DEVICE=0
VISION_MODEL_IMGSZ=320
VISION_MODEL_CONF=0.35
VISION_MODEL_CLASS_MAP_JSON='{"bottle":"box","person":"person"}'
VISION_MODEL_SOURCE_CONFIG_JSON='{"global_cam_01":{"model_path":"models/yolov8s-seg.pt","task":"segment","imgsz":640,"class_map":{"bottle":"box","person":"person"}},"tb3_1_picam":{"model_path":"models/yolov8n.pt","task":"detect","imgsz":320,"class_map":{"person":"person","bottle":"box"}},"tb3_2_picam":{"model_path":"models/yolov8n.pt","task":"detect","imgsz":320,"class_map":{"person":"person","bottle":"box"}}}'
VISION_GATEWAY_PUBLISH_EVIDENCE=false
# TurtleBot3 compressed camera publishers use sensor-data QoS (best effort).
# Match that offer so the AI gateway can receive Domain 2/5 camera frames.
VISION_GATEWAY_IMAGE_QOS_RELIABILITY=best_effort
WMS_EMIT_ENABLED=false
VISION_WEBRTC_ENABLED=true

VISION_SOURCE_1_ENABLED=true
VISION_SOURCE_1_ID=tb3_1_picam
VISION_SOURCE_1_DOMAIN=2
VISION_SOURCE_1_TOPIC=/camera/image_raw/compressed
VISION_SOURCE_1_INTERNAL_PORT=18090
VISION_SOURCE_2_ENABLED=true
VISION_SOURCE_2_ID=tb3_2_picam
VISION_SOURCE_2_DOMAIN=5
VISION_SOURCE_2_TOPIC=/camera/image_raw/compressed
VISION_SOURCE_2_INTERNAL_PORT=18091
PICAM_PUBLISH_WEBRTC=true
PICAM_WEBRTC_TARGET_FPS=30
PICAM_WEBRTC_AI_FPS=5
PICAM_WEBRTC_METRICS_DIR=${VISION_WEBRTC_COMPOSITOR_METRICS_DIR:-${SMARTFACTORY_VISION_RUN_DIR:-.run/vision}/compositor-metrics}

# Keep GoPro input quality and AI monitor budgets unchanged. Low-load trims public
# WebRTC publisher work, optional streams, and the global live stream target FPS;
# high-quality evidence capture stays separate from live WebRTC lift_roi.
GOPRO_PROTOCOL=TS
GOPRO_RESOLUTION=1080
GOPRO_FOV=WIDE
GOPRO_PORT=8554
GOPRO_TEST_READ=false
GOPRO_STREAM_WARMUP_SEC=8
GOPRO_INPUT=udp://0.0.0.0:8554
GOPRO_ADAPTER_INPUT=udp://0.0.0.0:8554
GOPRO_SOURCE=global_cam_01
GOPRO_ROI_VIEW=lift_roi
GOPRO_STREAM_TARGET_FPS=20
GOPRO_AI_MONITOR_FPS=5
GOPRO_AI_MONITOR_IMGSZ=640
GOPRO_PUBLISH_WEBRTC=true
GOPRO_PUBLISH_ROI_WEBRTC=false
GOPRO_WEBRTC_STALE_OVERLAY_AFTER_MS=1500
GOPRO_WEBRTC_METRICS_DIR=${VISION_WEBRTC_COMPOSITOR_METRICS_DIR:-${SMARTFACTORY_VISION_RUN_DIR:-.run/vision}/compositor-metrics}
GOPRO_WEBRTC_FULL_OUTPUT_WIDTH=960
GOPRO_WEBRTC_FULL_OUTPUT_HEIGHT=540
GOPRO_WEBRTC_ROI_OUTPUT_WIDTH=640
GOPRO_WEBRTC_ROI_OUTPUT_HEIGHT=480
GOPRO_WEBRTC_BITRATE=1600k
GOPRO_WEBRTC_BUFSIZE=300k
GOPRO_WEBRTC_GOP=10
GOPRO_EVIDENCE_IMGSZ=960
GOPRO_DROPPED_ITEM_CONF=0.25
GOPRO_EVIDENCE_CAPTURE_MODE=parallel_then_pause_then_stream_frame
GOPRO_EVIDENCE_RUNTIME_SCOPE=plan_mock_no_hardware
GOPRO_TARGET_FPS=5
GOPRO_BUFFERLESS=true
GOPRO_EVALUATE_LIFT_ROI=false
GOPRO_OPERATION=MONITOR
GOPRO_ROI_KIND=DROPPED_ITEM

# Diagnostic global MapROI overlay for the current lab map/camera placement.
# This is overlay-only guidance for operator tuning and future dropped-item ROI
# work; it is not a Main-facing safety/control contract.
VISION_MAP_ROI_ENABLED=true
VISION_MAP_ROI_SOURCE=global_cam_01
VISION_MAP_ROI_MARKER_IDS=11,12
VISION_MAP_ROI_FREEZE_MARKER_IDS=6,12
VISION_MAP_ROI_FREEZE_MODE=all
VISION_MAP_ROI_MIN_MARKERS=1
VISION_MAP_ROI_STALE_USABLE_S=180
VISION_MAP_ROI_POLYGON_NORMALIZED='0.18,0.01;0.90,0.01;0.82,0.98;0.26,0.98'

# Diagnostic static Zone ROI overlay for dropped-item tuning. These polygons are
# visual/operator guidance only; Main-facing hazard/evidence APIs still receive
# compact advisory JSON without raw polygons.
VISION_ZONE_ROI_ENABLED=true
VISION_ZONE_ROI_SOURCE=global_cam_01
VISION_ZONE_ROI_CONFIG_PATH=config/vision/zone_rois/global_cam_01_lab_draft.json

# MediaMTX sidecar receiver paths for low-load mode only.
# Main/browser sees burned overlay pixels in video. MJPEG remains fallback.
MEDIAMTX_RTSP_PORT=18554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_ICE_UDP_PORT=8189
MEDIAMTX_API_PORT=19997
MEDIAMTX_WEBRTC_ALLOW_ORIGINS=http://smartfactory-main.local:8088,http://localhost:8088,http://127.0.0.1:8088
WEBRTC_SIDECAR_PUBLIC_HOST=smartfactory-vision.local
WEBRTC_SIDECAR_STREAMS=global_cam_01/full,tb3_1_picam/full,tb3_2_picam/full
VISION_WEBRTC_SIDECAR_STREAMS=global_cam_01/full,tb3_1_picam/full,tb3_2_picam/full
WEBRTC_SIDECAR_COMPOSITOR_PUBLISHER_STREAMS=global_cam_01/full,tb3_1_picam/full,tb3_2_picam/full
VISION_WEBRTC_COMPOSITOR_PUBLISHER_STREAMS=global_cam_01/full,tb3_1_picam/full,tb3_2_picam/full
VISION_WEBRTC_COMPOSITOR_METRICS_DIR=${SMARTFACTORY_VISION_RUN_DIR:-.run/vision}/compositor-metrics
VISION_WEBRTC_COMPOSITOR_HEARTBEAT_MAX_AGE_S=5
VISION_WEBRTC_CLEAN_VIDEO_STREAMS=
VISION_WEBRTC_DIRECT_MEDIA_STREAMS=
VISION_WEBRTC_OVERLAY_REFRESH_FPS=5
WEBRTC_SIDECAR_INPUT_PRIORITY=mjpeg
WEBRTC_SIDECAR_MJPEG_INPUT_URL_TEMPLATE=http://127.0.0.1:8090/api/v1/vision/overlay/stream?source={source}\&view={view}\&max_fps={max_fps}
WEBRTC_SIDECAR_DIRECT_INPUT_URL_TEMPLATE_GLOBAL_CAM_01_FULL=
WEBRTC_SIDECAR_DIRECT_INPUT_FORMAT_GLOBAL_CAM_01_FULL=mpegts
WEBRTC_SIDECAR_INPUT_PRIORITY_GLOBAL_CAM_01_FULL=mjpeg
WEBRTC_SIDECAR_COPY_VIDEO_PATHS=
WEBRTC_SIDECAR_INPUT_MAX_FPS=20
WEBRTC_SIDECAR_TARGET_FPS=20
WEBRTC_SIDECAR_BITRATE=1600k
WEBRTC_SIDECAR_BUFSIZE=300k
WEBRTC_SIDECAR_GOP=10
WEBRTC_SIDECAR_X264_PRESET=ultrafast
WEBRTC_SIDECAR_INPUT_PROBESIZE=2048
WEBRTC_SIDECAR_INPUT_ANALYZEDURATION=0
WEBRTC_SIDECAR_INPUT_MAX_DELAY=0
WEBRTC_SIDECAR_DIRECT_INPUT_PROBESIZE=32768
WEBRTC_SIDECAR_DIRECT_INPUT_ANALYZEDURATION=1000000
WEBRTC_SIDECAR_DIRECT_INPUT_MAX_DELAY=0
WEBRTC_SIDECAR_AVIOFLAGS_DIRECT=false
WEBRTC_SIDECAR_OUTPUT_MUXDELAY=0
WEBRTC_SIDECAR_OUTPUT_MUXPRELOAD=0
VISION_WEBRTC_SIDECAR_WHEP_URL_TEMPLATE=http://smartfactory-vision.local:8889/{source}_{view}/whep
VISION_WEBRTC_SIDECAR_BROWSER_URL_TEMPLATE=http://smartfactory-vision.local:8889/{source}_{view}
VISION_WEBRTC_SIDECAR_HEALTH_URL=http://127.0.0.1:8889/
VISION_WEBRTC_SIDECAR_PATHS_API_URL=http://127.0.0.1:19997/v3/paths/list
VISION_WEBRTC_SIDECAR_HEALTH_TIMEOUT_S=0.25
