# SmartFactory ROS 2 FastDDS discovery defaults for the lab robot network.
#
# This file is deploy-root relative and host-agnostic: it contains no
# /home/<user> project paths. Override the peer lists from the shell or an
# operator override file when a lab uses different robot/PC addresses:
#
#   SMARTFACTORY_ROBOT_PEERS="192.168.30.101;192.168.30.102"
#   SMARTFACTORY_OPERATOR_PEERS="192.168.30.9;192.168.30.5;192.168.30.12;192.168.30.3"
#   SMARTFACTORY_ROS_STATIC_PEERS="<complete peer list>"
#
# The Vision profiles set per-source ROS_DOMAIN_ID values; this file provides
# the RMW/discovery context needed to discover robot PiCam publishers.

export ROS_DISTRO="${ROS_DISTRO:-jazzy}"
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"

# Use static peers instead of subnet-wide automatic discovery. Do not set
# ROS_AUTOMATIC_DISCOVERY_RANGE=OFF here; OFF disables automatic discovery.
unset ROS_LOCALHOST_ONLY
export ROS_AUTOMATIC_DISCOVERY_RANGE="${ROS_AUTOMATIC_DISCOVERY_RANGE:-LOCALHOST}"

export SMARTFACTORY_ROBOT_PEERS="${SMARTFACTORY_ROBOT_PEERS:-192.168.30.101;192.168.30.102}"
export SMARTFACTORY_OPERATOR_PEERS="${SMARTFACTORY_OPERATOR_PEERS:-192.168.30.9;192.168.30.5;192.168.30.12;192.168.30.3}"

__sf_ros_static_peers=""
if [ -n "${SMARTFACTORY_ROBOT_PEERS}" ]; then
  __sf_ros_static_peers="${SMARTFACTORY_ROBOT_PEERS}"
fi
if [ -n "${SMARTFACTORY_OPERATOR_PEERS}" ]; then
  if [ -n "${__sf_ros_static_peers}" ]; then
    __sf_ros_static_peers="${__sf_ros_static_peers};${SMARTFACTORY_OPERATOR_PEERS}"
  else
    __sf_ros_static_peers="${SMARTFACTORY_OPERATOR_PEERS}"
  fi
fi

export ROS_STATIC_PEERS="${ROS_STATIC_PEERS:-${SMARTFACTORY_ROS_STATIC_PEERS:-${__sf_ros_static_peers}}}"
unset __sf_ros_static_peers

# Optional ghost-participant cleanup profile. This is not a normal throughput
# optimization; only apply it when the file is present and avoid dangling paths.
if [ -n "${FASTRTPS_DEFAULT_PROFILES_FILE:-}" ]; then
  if [ ! -f "${FASTRTPS_DEFAULT_PROFILES_FILE}" ]; then
    unset FASTRTPS_DEFAULT_PROFILES_FILE
  fi
elif [ -f "${HOME}/.ros/fastdds_ghost_fix.xml" ]; then
  export FASTRTPS_DEFAULT_PROFILES_FILE="${HOME}/.ros/fastdds_ghost_fix.xml"
fi
