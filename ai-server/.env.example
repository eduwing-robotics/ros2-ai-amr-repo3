# SmartFactory AI Server local example.
# Keep durable endpoints hostname/env based. Production hostnames resolve only
# to the canonical 192.168.30.0/24 site LAN; keep IP fallbacks empty by default.

# Local-safe default. For Main/LAN access on the AI laptop, set AI_SERVER_HOST=0.0.0.0.
AI_SERVER_HOST=127.0.0.1
AI_SERVER_PORT=8100
VISION_PUBLIC_HOST=smartfactory-vision.local
MAIN_SERVER_URL=http://smartfactory-main.local:8088
AI_SERVER_CORS_ALLOW_ORIGINS=http://smartfactory-main.local:8088,http://localhost:8088,http://127.0.0.1:8088

CAMERA_SOURCES=global_cam_01,tb3_1_picam,tb3_2_picam
ROS_IMAGE_TOPICS=/global_camera/image_raw,/tb3_1/pi_camera/image_raw,/tb3_2/pi_camera/image_raw
VISION_EVENT_SCHEMA_VERSION=vision-event.v1
VISION_MONITOR_EVENT_SCHEMA_VERSION=vision-monitor-event.v1

# No-hardware / fixture mode can leave model worker disabled.
MODEL_NAME=mock-mvp1-detector
POLICY_VERSION=mvp2
VISION_MODEL_WORKER_ENABLED=false
VISION_MODEL_PATH=
VISION_MODEL_TASK=detect
VISION_MODEL_DEVICE=cpu
VISION_MODEL_IMGSZ=320

# Monitor profile identifiers used by compact API payloads.
PERSON_DRIVE_PROFILE_ID=person_drive_picam_v1
DROP_WATCH_PROFILE_ID=drop_watch_global_v1
LIFT_EVIDENCE_PROFILE_ID=lift_evidence_burst_v1
PERSON_DRIVE_THRESHOLD_SET_ID=person_pretrained_nano_v1
DROP_WATCH_THRESHOLD_SET_ID=drop_watch_fixture_v1
LIFT_EVIDENCE_THRESHOLD_SET_ID=lift_evidence_fixture_v1

WMS_EMIT_ENABLED=false
WMS_EMIT_TIMEOUT_S=2.0
WMS_EMIT_RETRIES=0
WMS_VISION_EVENTS_PATH=/api/v1/vision/events
SOURCE_TARGET_FPS=10.0
SOURCE_STALE_AFTER_S=2.0
SOURCE_OFFLINE_AFTER_S=30.0

# Required for Main→AI monitor/evidence mutations. Match LMS_VISION_HMAC_SECRET
# from Main. Leave empty only for read-only-only deployments: mutations fail closed.
MAIN_HMAC_SECRET=
MAIN_HMAC_CLOCK_SKEW_SEC=60
# Dedicated ROS vision-frame gateway credential. This is not MAIN_HMAC_SECRET.
# It signs only POST /api/v1/vision/frame and /frame/process with
# X-SF-Timestamp, X-SF-Nonce, and X-SF-Gateway-Signature.
VISION_GATEWAY_HMAC_SECRET=
# AI_NO_HARDWARE=true creates a process-local HMAC credential for local fixture runs;
# callers must still sign mutations. Never use it for shared/production deployments.
AI_NO_HARDWARE=false

# Debug frame/process/synthetic/detect/evaluate routes are HMAC-protected by
# default because they share the evidence cache. Set true only for an isolated
# fixture/lab process that is never used for production evidence.
AI_DEBUG_MUTATIONS_ENABLED=false
