# Simulator runtime overrides (copy to .env or export manually).
# Paths: docs/reference/PATHS.md

# --- Map / world ---
# MAP_NAME=sample
# MAP_YAML=maps/custom/map.yaml
# WAREHOUSE_WORLD=1
# WALL_HEIGHT_M=0.50

# --- Robot spawn & AMCL initial pose ---
# INITIAL_X=0.765
# INITIAL_Y=0.58
# INITIAL_YAW=-1.57

# --- ROS / Gazebo ---
# TURTLEBOT3_MODEL=burger
# ROS_DOMAIN_ID=2
# GAZEBO_GUI=0
# RVIZ=1

# --- Repo-relative roots (optional; auto-detected from scripts/) ---
# SIMULATOR_ROOT=.                    # default: script parent
# NAV2_REFECTOR_ROOT=../WS/nav2_REFECTOR
# EXTRA_ROS_SETUP=../turtlebot3_ws/install/setup.bash
# ROS_SETUP=/opt/ros/jazzy/setup.bash  # system install, not in repo

# --- Nav API ---
# API_PORT=8001
# ROBOT_ID=tb3_burger_01
# MULTI_NAV_API=0

# --- Profile loader ---
# eval "$(bash scripts/load_profile.sh sample)"
