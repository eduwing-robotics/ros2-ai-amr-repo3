      "allowed_index_names": [
        "README.md"
      ],
      "requires_index": false,
      "required_markdown_metadata": [
        "h1"
      ],
      "review_only_content_rule": "Root script catalog, safe entrypoint usage, and links only."
    },
    {
      "rule_id": "root-policy",
      "document_type": "index",
      "subject": "documentation",
      "path_globs": [
        "docs/README.md",
        "docs/DOCUMENTATION_GUIDE.md"
      ],
      "allowed_index_names": [
        "README.md",
        "DOCUMENTATION_GUIDE.md"
      ],
      "requires_index": false,
      "required_markdown_metadata": [
        "h1"
      ],
      "review_only_content_rule": "Shared policy and routing only."
    },
    {
