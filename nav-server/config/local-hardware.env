# TB3_2 lab hardware connection defaults for start_all_tb3_2.sh.
# The launcher parses this as data; it does not execute shell syntax. Process
# environment variables override these values, and NAV_LOCAL_ENV_FILE can point
# the launcher at a different file.

# SSH key authentication is preferred. ROBOT_PW is a local password fallback
# used only when sshpass is installed; the launcher never logs its value.
ROBOT_SSH=musk@192.168.30.102
ROBOT_PW=1234

# TurtleBot3 and lift overlays on the robot SBC.
ROBOT_WS_SETUP=/home/musk/turtlebot3_ws/install/setup.bash
LIFT_WS_SETUP=/home/musk/lift_project/ros2_ws/install/setup.bash
