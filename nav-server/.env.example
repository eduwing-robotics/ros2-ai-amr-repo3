# Nav server environment template (copy to .env for local overrides)

ROBOT_ID=tb3_burger_01
ROS_DOMAIN_ID=2
SIMULATION_MODE=0
DRY_RUN_MISSION=0

ROBOTS_CONFIG_PATH=config/robots.json
MAIN_SERVER_ROUTES_PATH=config/main_server_routes.json
ACTIVE_MAP_YAML=map/robot2_map.yaml

# Canonical trusted-site Main API base. The hostname must resolve inside 192.168.30.0/24.
MAIN_API_BASE=http://smartfactory-main.local:8088/api/v1
LMS_PUBLIC_BASE_URL=http://smartfactory-main.local:8088
MAIN_CALLBACK_TIMEOUT_SEC=2.0
# Loopback is permitted only for explicit hardware-less tests.
NAV_NOHARDWARE=0
NAV_NOHARDWARE_CALLBACK_ALLOWLIST=
# Main↔Nav HMAC is loaded by scripts/sf_nav.sh from the ignored repository-level
# .secrets/service-hmac.env bundle. Do not duplicate it in this file.
NAV_MAIN_HMAC_CLOCK_SKEW_SEC=60
# Retired ingress. Leave disabled; it never accepts inbound/outbound work.
NAV_LEGACY_MISSION_START_ENABLED=0
HOSTNAME_RESOLVE_TIMEOUT_SEC=0.3

ARUCO_DETECTION_TOPIC=
ARUCO_MARKER_SIZE_M=0.05
FORK_INSERT_ENABLED=1

# Local TB3_2 SSH and workspace settings are maintained in the tracked
# config/local-hardware.env deployment file. A process environment value wins.
# SSH key authentication is the default; ROBOT_PW is an optional local password
# used only with sshpass and is never printed by start_all_tb3_2.sh.
ROBOT_SSH=
ROBOT_PW=
ROBOT_WS_SETUP=
LIFT_WS_SETUP=
