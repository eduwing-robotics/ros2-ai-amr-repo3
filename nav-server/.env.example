# Nav server environment template (copy to .env for local overrides)

ROBOT_ID=tb3_burger_01
ROS_DOMAIN_ID=2
SIMULATION_MODE=0
DRY_RUN_MISSION=0

ROBOTS_CONFIG_PATH=config/robots.json
MAIN_SERVER_ROUTES_PATH=config/main_server_routes.json
ACTIVE_MAP_YAML=map/robot1_map.yaml

# HTTPS Main API base. Nav only posts to its fixed /movement callback paths.
MAIN_API_BASE=https://smartfactory-main.example/api/v1
LMS_PUBLIC_BASE_URL=
MAIN_CALLBACK_TIMEOUT_SEC=2.0
# Loopback is permitted only for explicit hardware-less tests.
NAV_NOHARDWARE=0
NAV_NOHARDWARE_CALLBACK_ALLOWLIST=
# Required for Main-controlled commands and callbacks; same value as Main's
# LMS_MOVEMENT_HMAC_SECRET. Health/status GET endpoints intentionally remain public.
NAV_MAIN_HMAC_SECRET=
NAV_MAIN_HMAC_CLOCK_SKEW_SEC=60
# Retired ingress. Leave disabled; it never accepts inbound/outbound work.
NAV_LEGACY_MISSION_START_ENABLED=0
HOSTNAME_RESOLVE_TIMEOUT_SEC=0.3

ARUCO_DETECTION_TOPIC=
ARUCO_MARKER_SIZE_M=0.05
FORK_INSERT_ENABLED=1
