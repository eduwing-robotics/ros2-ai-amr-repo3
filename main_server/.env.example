# Main server public URL reachable from Movement/Camera/Vision callbacks.
LMS_PUBLIC_BASE_URL=http://smartfactory-main.local:8088

# PostgreSQL runtime DB. Required for real backend work.
LMS_DATABASE_URL=postgresql://lms:lms@localhost:5432/lms_mvp
LMS_MAP_ASSETS_DIR=./maps

# Legacy SQLite path variables are intentionally omitted from the default template.
# Do not use SQLite for new development or operations.

# Movement/Nav2 server routing.
# fake: Movement 서버 없이 화면/API 확인
# http: 실제 Movement 서버 호출
LMS_MOVEMENT_CLIENT_MODE=http
LMS_MOVEMENT_HOST=smartfactory-nav.local
LMS_MOVEMENT_FALLBACK_HOST=192.168.10.54
# LMS_MOVEMENT_BASE_URLS=tb3_1=http://smartfactory-nav.local:8001/movement-api/v1,tb3_2=http://smartfactory-nav.local:8002/movement-api/v1
# LMS_MOVEMENT_FALLBACK_BASE_URLS=tb3_1=http://192.168.10.54:8001/movement-api/v1,tb3_2=http://192.168.10.54:8002/movement-api/v1
LMS_MOVEMENT_ACTIVE_MAP_ID=robot2_map
LMS_POSE_RECEIVE_STALE_SEC=1.5
LMS_POSE_RECEIVE_LOST_SEC=5.0
LMS_POSE_SOURCE_STALE_SEC=5.0
LMS_POSE_SOURCE_LOST_SEC=10.0
LMS_POSE_RECOVERY_SAMPLES=3
LMS_POSE_WATCHDOG_INTERVAL_SEC=0.25
LMS_POSE_POLL_INTERVAL_SEC=0.25
LMS_POSE_PUSH_PREFERRED_SEC=0.5
LMS_POSE_EVENT_QUEUE_SIZE=256
LMS_POSE_EVENT_RETRY_LIMIT=5
LMS_POSE_MAX_SOURCE_AGE_SEC=86400
LMS_POSE_JUMP_DISTANCE_M=1.0
LMS_POSE_JUMP_SPEED_MPS=1.0
LMS_MOVEMENT_TIMEOUT_SEC=3.0
LMS_MOVEMENT_HEALTH_TIMEOUT_SEC=0.8
# Movement -> Main callback shared token. Use the same non-empty value on both servers for release.
LMS_MOVEMENT_CALLBACK_TOKEN=

# Camera server (rosbridge). UI 카메라 배지는 Vision stream(:8090) health.
LMS_CAMERA_HOST=smartfactory-nav.local
LMS_CAMERA_API_PORT=8080
LMS_CAMERA_STREAM_PORT=9090
# LMS_CAMERA_STREAM_URL_TEMPLATE=ws://{host}:9090/{source_id}

# Vision/AI server and MJPEG stream bridge.
# 호스트명 우선(.local). 해석/연결 실패 시 FALLBACK(IP)로 1회 재시도한다(비우면 폴백 없음).
LMS_VISION_API_BASE_URL=http://smartfactory-vision.local:8100
LMS_VISION_STREAM_BASE_URL=http://smartfactory-vision.local:8090
LMS_VISION_API_FALLBACK_BASE_URL=http://<vision-ip>:8100
LMS_VISION_STREAM_FALLBACK_BASE_URL=http://<vision-ip>:8090
LMS_VISION_TIMEOUT_SEC=2.0
LMS_VISION_STREAM_TIMEOUT_SEC=3.0

# Person hazard — AI advisory polling; set ENABLED=false to disable auto E-stop.
LMS_PERSON_HAZARD_ENABLED=true
LMS_PERSON_HAZARD_ACTION=estop
LMS_PERSON_HAZARD_TARGET_FPS=3
LMS_PERSON_HAZARD_POLL_HZ=3
LMS_PERSON_HAZARD_STALE_SEC=2.0
LMS_PERSON_HAZARD_COOLDOWN_SEC=2.0
LMS_PERSON_HAZARD_TIMEOUT_SEC=0.5
LMS_RECOVERY_SAFE_LOCATION_ID=HOME_01

# Frontend build — WebRTC transport primary. Vision sidecar ready + UDP media 검증 후 활성화.
# sidecar not_configured면 프론트가 자동 MJPEG 폴백한다.
VITE_VISION_WEBRTC_ENABLED=true
# 개발·시그널링 테스트: MJPEG 폴백 끔. ONLY=true면 ENABLED 없이도 WebRTC 경로만 시도한다.
# VITE_VISION_WEBRTC_ONLY=true

# Manual control defaults.
LMS_MANUAL_ROTATE_DURATION_SEC=1.0
LMS_MANUAL_ROTATE_ANGULAR_Z=0.5
LMS_MANUAL_TRANSLATE_DURATION_SEC=1.0
LMS_MANUAL_TRANSLATE_LINEAR_X=0.1
LMS_MANUAL_HOLD_TIMEOUT_SEC=2.0
LMS_MANUAL_OVERRIDE_NAV=false

# Frontend dev server proxy target.
VITE_API_PROXY_TARGET=http://smartfactory-main.local:8088
